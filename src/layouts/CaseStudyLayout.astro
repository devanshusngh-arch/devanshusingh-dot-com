---
/*
  CaseStudyLayout.astro
  =====================
  Reusable layout for full case-study pages (KodeKloud, Simplilearn).
  Drop this in your existing Astro project's src/layouts/ folder.

  Props you pass from the page:
    title        – Page <title> and hero headline
    company      – Company name (used in meta + breadcrumb)
    role         – Your title at the company
    duration     – e.g. "2022 – 2024"
    heroTagline  – One-liner below the title
    accentColor  – Hex string for per-case-study accent (e.g. "#FF6B35")
    ogImage      – (optional) social share image path
*/
interface Props {
  title: string;
  company: string;
  role: string;
  duration: string;
  heroTagline: string;
  accentColor?: string;
  ogImage?: string;
}

const {
  title,
  company,
  role,
  duration,
  heroTagline,
  accentColor = "#3B82F6",
  ogImage = "/og-default.jpg",
} = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Devanshu Singh</title>
  <meta name="description" content={heroTagline} />
  <meta property="og:title" content={`${title} — Devanshu Singh`} />
  <meta property="og:description" content={heroTagline} />
  <meta property="og:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>

<body>
  <!-- ========== HERO ========== -->
  <section class="cs-hero" style={`--accent: ${accentColor};`}>
    <div class="cs-hero__inner">
      <nav class="cs-breadcrumb">
        <a href="/">Home</a>
        <span class="cs-breadcrumb__sep">/</span>
        <a href="/work">Work</a>
        <span class="cs-breadcrumb__sep">/</span>
        <span class="cs-breadcrumb__current">{company}</span>
      </nav>

      <h1 class="cs-hero__title">{title}</h1>
      <p class="cs-hero__tagline">{heroTagline}</p>

      <div class="cs-hero__meta">
        <div class="cs-hero__meta-item">
          <span class="cs-hero__meta-label">Role</span>
          <span class="cs-hero__meta-value">{role}</span>
        </div>
        <div class="cs-hero__meta-item">
          <span class="cs-hero__meta-label">Company</span>
          <span class="cs-hero__meta-value">{company}</span>
        </div>
        <div class="cs-hero__meta-item">
          <span class="cs-hero__meta-label">Period</span>
          <span class="cs-hero__meta-value">{duration}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CONTENT (slot) ========== -->
  <main class="cs-content">
    <slot />
  </main>

  <!-- ========== FOOTER NAV ========== -->
  <nav class="cs-footer-nav">
    <a href="/work" class="cs-footer-nav__back">← All Work</a>
  </nav>
</body>
</html>

<style is:global define:vars={{ accentColor }}>
  /* ── Reset & Base ──────────────────────────── */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    /* CHANGE THESE to match your CREATIVE_SYSTEM_v34 tokens */
    --font-display: 'Playfair Display', serif;
    --font-body: 'Inter', system-ui, sans-serif;

    --color-bg: #0a0a0f;
    --color-surface: #111118;
    --color-text: #f0f0f0;
    --color-text-muted: #666680;
    --color-border: #1e1e2e;

    /* Per-page accent passed via prop */
    --accent: #3B82F6;
  }

  body {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  a:hover { opacity: 0.8; }

  /* ── Hero ───────────────────────────────────── */
  .cs-hero {
    padding: 6rem 2rem 4rem;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }
  .cs-hero::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 120%;
    background: radial-gradient(ellipse, color-mix(in srgb, var(--accent) 12%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }
  .cs-hero__inner {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }

  .cs-breadcrumb {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: var(--color-text-muted);
  }
  .cs-breadcrumb a { color: var(--color-text-muted); }
  .cs-breadcrumb__sep { margin: 0 0.5rem; opacity: 0.4; }
  .cs-breadcrumb__current { color: var(--color-text); }

  .cs-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .cs-hero__tagline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .cs-hero__meta {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .cs-hero__meta-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .cs-hero__meta-value {
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* ── Content Area ──────────────────────────── */
  .cs-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  /* Utility classes for case study sections */
  .cs-section {
    margin-bottom: 4rem;
  }
  .cs-section__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .cs-section__heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }
  .cs-section p {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: 1rem;
    max-width: 680px;
  }

  /* Stats row */
  .cs-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 3rem;
  }
  .cs-stat {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .cs-stat__number {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--accent);
    display: block;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }
  .cs-stat__label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Video embed container */
  .cs-video {
    margin: 2.5rem 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .cs-video__wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
  }
  .cs-video__wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .cs-video__caption {
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
  }

  /* Image / screenshot */
  .cs-image {
    margin: 2.5rem 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .cs-image img {
    width: 100%;
    display: block;
  }

  /* Highlight / pull quote */
  .cs-highlight {
    border-left: 3px solid var(--accent);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .cs-highlight p {
    color: var(--color-text);
    font-size: 1.05rem;
    font-style: italic;
    margin: 0;
  }

  /* Footer nav */
  .cs-footer-nav {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
    border-top: 1px solid var(--color-border);
  }
  .cs-footer-nav__back {
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 640px) {
    .cs-hero { padding: 4rem 1.25rem 3rem; }
    .cs-content { padding: 3rem 1.25rem 4rem; }
    .cs-hero__meta { gap: 1.5rem; }
    .cs-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
