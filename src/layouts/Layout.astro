---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	active?: 'work' | 'resume' | 'contact';
}

const { title, active } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Marcus — AI Brand Strategist by Devanshu Singh. AI-powered brand strategy research assistant.">
		<meta property="og:title" content="Devanshu Singh — Creative Lead">
		<meta property="og:description" content="Portfolio of Devanshu Singh — Creative Lead, Brand Strategist, GenAI-native production.">
		<meta property="og:image" content="/og-image.png">
		<title>{title} | Devanshu Singh</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<Header active={active} />
		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<div class="footer-links">
					<a href="mailto:devanshusngh@gmail.com" class="footer-link">devanshusngh@gmail.com</a>
					<span class="footer-dot">·</span>
					<a href="https://linkedin.com/in/devanshu-singh-356896a0" target="_blank" rel="noopener noreferrer" class="footer-link">linkedin.com/in/devanshu-singh-356896a0</a>
				</div>
				<p class="footer-copy">© 2026 Devanshu Singh</p>
			</div>
		</footer>
	</body>
</html>
