---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume" active="resume">

	<section class="section">

		<!-- Header -->
		<div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 80px; flex-wrap: wrap;">
			<div>
				<h1 class="display-heading" style="font-size: clamp(40px, 7vw, 72px); margin: 0 0 8px 0;">Resume</h1>
				<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 300; font-size: 15px; color: var(--muted); margin: 0;">Creative Strategy &amp; Brand Content Lead</p>
			</div>
			<a href="/Devanshu_Pratap_Singh___Creative_Strategy___Brand_Content_Lead.pdf" style="display: inline-block; padding: 10px 24px; border: 1px solid var(--accent); color: var(--accent); font-family: 'Inter', system-ui, sans-serif; font-weight: 500; font-size: 13px; text-decoration: none; border-radius: 100px; transition: background 0.2s ease, color 0.2s ease;" onmouseover="this.style.background='var(--accent)';this.style.color='#fff';" onmouseout="this.style.background='transparent';this.style.color='var(--accent)';">
				Download PDF
			</a>
		</div>

		<!-- SUMMARY -->
		<div class="resume-section">
			<span class="section-label">Summary</span>
			<p class="body-text" style="margin: 0;">
				Creative strategy and design leader with 8+ years building brand systems, visual frameworks, and campaign direction across EdTech, SaaS, and agency environments. Translates brand positioning and business objectives into scalable design systems — from visual identity and brand guidelines to cross-channel campaign execution.
			</p>
		</div>

		<!-- EXPERIENCE -->
		<div class="resume-section">
			<span class="section-label">Experience</span>

			<!-- KodeKloud -->
			<div class="resume-entry">
				<div class="resume-entry-header">
					<span class="resume-role">Associate Creative Director</span>
					<span class="resume-date">Dec 2022 – Oct 2025</span>
				</div>
				<p class="resume-company">KodeKloud</p>
				<ul class="resume-bullets">
					<li>Led lean creative team of 3, 200+ brand assets annually</li>
					<li>Developed end-to-end brand and visual strategy, scalable design systems</li>
					<li>Drove cross-channel campaigns — CTR improved 18%</li>
					<li>Built GenAI workflow (ElevenLabs, Midjourney, Firefly, Descript) — production time cut 35%, output 3×</li>
					<li>Managed freelancer relationships and vendor briefs</li>
				</ul>
			</div>

			<!-- Simplilearn -->
			<div class="resume-entry">
				<div class="resume-entry-header">
					<span class="resume-role">Assistant Manager – Motion Graphic Artist</span>
					<span class="resume-date">Jan 2021 – Dec 2022</span>
				</div>
				<p class="resume-company">Simplilearn</p>
				<ul class="resume-bullets">
					<li>Led team of 8 motion designers, 150–200 assets/quarter, 500K → 2M+ subscribers</li>
					<li>Creative liaison between social, paid media, production — 10–15% CTR improvement</li>
					<li>Course promo videos at 35%+ average view rate</li>
					<li>Reduced turnaround 25% via standardized templates</li>
				</ul>
			</div>

			<!-- Zolostays -->
			<div class="resume-entry">
				<div class="resume-entry-header">
					<span class="resume-role">Creative Producer (Contract)</span>
					<span class="resume-date">Sep 2020 – Jan 2021</span>
				</div>
				<p class="resume-company">Zolostays</p>
				<ul class="resume-bullets">
					<li>Conceptualized and executed Zolo Got Talent brand campaign — contestant videos, teasers, logo animation</li>
				</ul>
			</div>

			<!-- Webenza -->
			<div class="resume-entry">
				<div class="resume-entry-header">
					<span class="resume-role">Executive – Digital Media &amp; Design</span>
					<span class="resume-date">Nov 2018 – Sep 2020</span>
				</div>
				<p class="resume-company">Webenza</p>
				<ul class="resume-bullets">
					<li>Managed creative production across 50+ clients — Amazon, Bosch, Schneider Electric, Ola Money</li>
					<li>A/B tests on hooks, thumbnails, CTAs</li>
					<li>Built QC workflows adopted agency-wide, reducing review cycles 20%</li>
				</ul>
			</div>

			<!-- BYJU'S -->
			<div class="resume-entry">
				<div class="resume-entry-header">
					<span class="resume-role">Creative Associate</span>
					<span class="resume-date">Aug 2017 – Oct 2018</span>
				</div>
				<p class="resume-company">BYJU'S</p>
				<ul class="resume-bullets">
					<li>Motion graphics and animation for K-12 STEM curriculum</li>
					<li>Collaborated with subject matter experts and content R&amp;D</li>
				</ul>
			</div>
		</div>

		<!-- CORE COMPETENCIES -->
		<div class="resume-section">
			<span class="section-label">Core Competencies</span>
			<div style="display: flex; flex-wrap: wrap; gap: 8px;">
				{[
					'Brand Strategy', 'Design Strategy', 'Creative Direction', 'Visual Design Systems', 'Brand Identity',
					'Brand Communication', 'Campaign Design', 'Motion Graphics', 'Video Production', 'Creative Ops',
					'Performance Creative & A/B Testing', 'GenAI & AI Workflows', 'Team Leadership', 'People Management',
					'Stakeholder Management', 'Project Management', 'Social Media Strategy', 'Marketing Communication'
				].map(skill => (
					<span class="pill">{skill}</span>
				))}
			</div>
		</div>

		<!-- CERTIFICATIONS -->
		<div class="resume-section">
			<span class="section-label">Certifications</span>
			<div>
				<div class="cert-row">
					<div>
						<a href="https://coursera.org/share/e3da0db7473132149ef8e42fc53e1861" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">Strategic Brand Management</a>
						<p class="cert-org">SP Jain × Coursera</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row">
					<div>
						<a href="https://coursera.org/share/cecaf3aa93b6f3e45a8d27fc063c8c51" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">Agentic AI Creative Workflow</a>
						<p class="cert-org">Adobe × Coursera</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row">
					<div>
						<a href="https://coursera.org/share/649807601f3eb44e86669a165b7dc66a" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">ChatGPT &amp; Zapier: Agentic AI</a>
						<p class="cert-org">Vanderbilt × Coursera</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row">
					<div>
						<a href="https://coursera.org/share/bf05c2f1b0dc04a181da7121c502d497" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">IBM AI Product Manager</a>
						<p class="cert-org">IBM × Coursera</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row">
					<div>
						<a href="https://coursera.org/share/de4a151ddd2bdcdcc8ee08c09fc00a86" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">Google AI Essentials</a>
						<p class="cert-org">Google × Coursera</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row">
					<div>
						<a href="https://ude.my/UC-e138018a-c5d2-407f-b360-4b8b1d434b56" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">SaaS Explainer Video</a>
						<p class="cert-org">Udemy · Mar 2026</p>
					</div>
					<span class="cert-year">2026</span>
				</div>
				<div class="cert-row" style="border-bottom: none;">
					<div>
						<a href="https://app-na2.hubspot.com/academy/achievements/pypkq96l/en/1/devanshu-singh/inbound-marketing-certified" target="_blank" rel="noopener noreferrer" class="cert-name" style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.12); text-underline-offset: 3px;">Inbound Marketing Certified</a>
						<p class="cert-org">HubSpot Academy</p>
					</div>
					<span class="cert-year">2025</span>
				</div>
			</div>
		</div>

		<!-- EDUCATION -->
		<div class="resume-section">
			<span class="section-label">Education</span>
			<div style="padding: 20px 0; border-top: 1px solid rgba(255,255,255,0.08);">
				<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 500; font-size: 16px; color: var(--primary); margin: 0 0 4px 0;">B.Tech · Electrical Engineering</p>
				<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 13px; color: var(--muted); margin: 0 0 4px 0;">JSS Academy of Technical Education · Noida, Delhi NCR</p>
				<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 12px; color: var(--muted); margin: 0;">2011–2015</p>
			</div>
		</div>

		<!-- TOOLS -->
		<div class="resume-section">
			<span class="section-label">Tools</span>
			<div class="tools-grid">
				<div>
					<p class="tools-category-label">GenAI &amp; AI</p>
					<p class="tools-list">Claude Code · Google AI Studio · AntiGravity (Google) · Zapier AI Workflows · N8N · ElevenLabs · Midjourney · Adobe Firefly · Descript</p>
				</div>
				<div>
					<p class="tools-category-label">Creative Suite</p>
					<p class="tools-list">Adobe Creative Cloud · Photoshop &amp; Illustrator · InDesign · After Effects &amp; Premiere Pro · Figma · Canva</p>
				</div>
				<div>
					<p class="tools-category-label">Productivity &amp; Ops</p>
					<p class="tools-list">Google Workspace · ClickUp · Slack · MCP (Model Context Protocol) · Frame.io</p>
				</div>
				<div>
					<p class="tools-category-label">Analytics</p>
					<p class="tools-list">Google Analytics 4 · YouTube Studio · HubSpot Analytics</p>
				</div>
			</div>
		</div>

		<!-- STRENGTHS -->
		<div class="resume-section">
			<span class="section-label">Strengths</span>
			<div>
				<div class="strength-entry">
					<p class="strength-title">People &amp; Stakeholder Leadership</p>
					<p class="strength-desc">Led teams of 3–8, managed external vendors, aligned cross-functional stakeholders from brief through delivery.</p>
				</div>
				<div class="strength-entry">
					<p class="strength-title">GenAI-Native Production</p>
					<p class="strength-desc">Agentic AI workflows that cut cost without cutting quality or brand standards.</p>
				</div>
				<div class="strength-entry" style="border-bottom: none;">
					<p class="strength-title">Data-Informed Creative</p>
					<p class="strength-desc">A/B testing and analytics driving every creative decision — not gut feel.</p>
				</div>
			</div>
		</div>

	</section>

</Layout>
