---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Work">
	<section class="section-padding">
		<h1 class="text-6xl md:text-8xl mb-12">Case Studies</h1>
		<div class="grid gap-16">
			<!-- KodeKloud -->
			<div class="portfolio-card grid md:grid-cols-2 gap-8 p-8 md:p-12">
				<div class="space-y-6">
					<h2 class="text-4xl">KodeKloud</h2>
					<p class="text-lg text-portfolio-muted font-light leading-relaxed">
						Led the creative transformation for one of the leading DevOps learning platforms. 
						Implemented GenAI-native production workflows that increased output by 300% while maintaining premium quality.
					</p>
					<ul class="space-y-4">
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>Scaled subscriber base from 125K to 300K+</span>
						</li>
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>18% CTR improvement via visual strategy refactor</span>
						</li>
					</ul>
					<div class="pt-4">
						<span class="px-4 py-2 bg-portfolio-mid/30 text-xs rounded-full uppercase tracking-widest">Case study coming soon</span>
					</div>
				</div>
				<div class="bg-portfolio-mid/20 rounded-xl aspect-video flex items-center justify-center border border-portfolio-mid/30 italic text-portfolio-muted">
					Visual Asset Placeholder
				</div>
			</div>

			<!-- Simplilearn -->
			<div class="portfolio-card grid md:grid-cols-2 gap-8 p-8 md:p-12">
				<div class="space-y-6">
					<h2 class="text-4xl">Simplilearn</h2>
					<p class="text-lg text-portfolio-muted font-light leading-relaxed">
						Directed a diverse team of 8 creative professionals across video, design, and motion. 
						Orchestrated large-scale content campaigns that drove massive audience growth in the competitive professional certification space.
					</p>
					<ul class="space-y-4">
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>500K to 2M+ subscriber growth milestone</span>
						</li>
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>Consistently achieved 35%+ average view rates</span>
						</li>
					</ul>
					<div class="pt-4">
						<span class="px-4 py-2 bg-portfolio-mid/30 text-xs rounded-full uppercase tracking-widest">Case study coming soon</span>
					</div>
				</div>
				<div class="bg-portfolio-mid/20 rounded-xl aspect-video flex items-center justify-center border border-portfolio-mid/30 italic text-portfolio-muted">
					Visual Asset Placeholder
				</div>
			</div>

			<!-- Webenza -->
			<div class="portfolio-card grid md:grid-cols-2 gap-8 p-8 md:p-12">
				<div class="space-y-6">
					<h2 class="text-4xl">Webenza</h2>
					<p class="text-lg text-portfolio-muted font-light leading-relaxed">
						Client-facing leadership managing creative requirements for over 50 global brands. 
						Developed holistic digital identities and high-performing advertising campaigns for market leaders.
					</p>
					<ul class="space-y-4">
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>Managed Amazon, Bosch, and Schneider Electric accounts</span>
						</li>
						<li class="flex items-center gap-3 text-sm">
							<span class="h-1.5 w-1.5 rounded-full bg-portfolio-accent"></span>
							<span>Delivered 100+ multi-channel integrated campaigns</span>
						</li>
					</ul>
					<div class="pt-4">
						<span class="px-4 py-2 bg-portfolio-mid/30 text-xs rounded-full uppercase tracking-widest">Case study coming soon</span>
					</div>
				</div>
				<div class="bg-portfolio-mid/20 rounded-xl aspect-video flex items-center justify-center border border-portfolio-mid/30 italic text-portfolio-muted">
					Visual Asset Placeholder
				</div>
			</div>
		</div>
	</section>
</Layout>
