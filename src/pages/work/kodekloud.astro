---
/*
  /work/kodekloud.astro
  =====================
  Full case study page — KodeKloud
*/
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import StatCard from '../../components/StatCard.astro';
---

<CaseStudyLayout
  title="Building Creative Infrastructure from Zero"
  company="KodeKloud"
  role="Senior Creative / Associate Creative Director"
  duration="2022 – 2024"
  heroTagline="Took over the entire marketing video operation from the CEO and CMO. Built the creative team, the pipeline, and the design system that scaled KodeKloud's YouTube channel from 125K to 300K+ subscribers."
  accentColor="#FF6B35"
>

  <!-- SECTION 1 — THE PROBLEM -->
  <section class="cs-section">
    <span class="cs-section__label">The Problem</span>
    <h2 class="cs-section__heading">No creative team. No design system. No pipeline.</h2>
    <p>
      When I joined KodeKloud, the CEO and CMO were personally managing all marketing video output. There was no creative team, no brand system, and no production pipeline. The channel had 125K subscribers but the creative operation was running on willpower.
    </p>
  </section>

  <!-- SECTION 2 — THE APPROACH -->
  <section class="cs-section">
    <span class="cs-section__label">The Approach</span>
    <h2 class="cs-section__heading">Built the operation from the ground up</h2>
    <p>
      Took over the entire marketing video effort. Worked with a motion designer, an editor, and a UI designer to build the brand guidelines, template system, and QC process. Set up pipelines for YouTube, social media, testimonials, explainers, ads, and instructional content.
    </p>
    <p>
      Ran quarterly content calendars with weekly prioritization. Planned 30+ videos per month across 8 formats: full-length tutorials, reels, KodeKloud Engineer, Weekend of Learning, ads, testimonials, course repurpose, and podcasts. Ran campaigns for Free Week, Black Friday, and KodeKloud AI.
    </p>
    <p>
      Applied an SEO-first strategy targeting high-volume keywords and competitive gaps. Built go-to-market ad campaigns for Kubestronaut, Cloud, and 100 Days of DevOps launches.
    </p>
  </section>

  <!-- BRAND DECODE — Strategic Context -->
  <section class="cs-section">
    <span class="cs-section__label">Brand Decode</span>
    <h2 class="cs-section__heading">The brand I was building for</h2>
    <p>
      Every creative decision was made against a specific brand framework. Here is how KodeKloud's brand was structured.
    </p>
  </section>

  <!-- Brand Identity Grid -->
  <div class="cs-brand-grid">
    <div class="cs-brand-card" style="--card-accent: #FF6B35;">
      <span class="cs-brand-tag">Archetype</span>
      <h3 class="cs-brand-title">The Magician</h3>
      <p class="cs-brand-desc">Transforming learners into cloud professionals through hands-on alchemy. Making the complex feel accessible, the technical feel doable.</p>
    </div>
    <div class="cs-brand-card" style="--card-accent: #10B981;">
      <span class="cs-brand-tag">Audience</span>
      <h3 class="cs-brand-title">DevOps &amp; Cloud Aspirants</h3>
      <p class="cs-brand-desc">IT professionals (25–35) in India and Tier-2 cities. Price-sensitive, impatient with slides, community-driven. They value practical skills over certificates.</p>
    </div>
    <div class="cs-brand-card" style="--card-accent: #3B82F6;">
      <span class="cs-brand-tag">Positioning</span>
      <h3 class="cs-brand-title">Hands-On. Instant. No Setup.</h3>
      <p class="cs-brand-desc">Real cloud labs running in browser. Zero setup, instant access. The affordable specialist in a sea of expensive generalists.</p>
    </div>
    <div class="cs-brand-card" style="--card-accent: #F59E0B;">
      <span class="cs-brand-tag">Tone &amp; Persona</span>
      <h3 class="cs-brand-title">Senior Engineer Mentoring a Junior</h3>
      <p class="cs-brand-desc">Authoritative yet approachable. No-fluff, accessible mentor. Dark console aesthetic. Supportive, direct, celebratory of small wins.</p>
    </div>
  </div>

  <!-- POP / POD Comparison -->
  <div class="cs-pp">
    <div class="cs-pp__col cs-pp__pop">
      <div class="cs-pp__header" style="background: color-mix(in srgb, #3B82F6 8%, transparent); border-bottom: 1px solid var(--color-border, #1e1e2e);">
        <span class="cs-pp__tag" style="color: #3B82F6;">Points of Parity</span>
        <h3 class="cs-pp__title">What KodeKloud shares with competitors</h3>
      </div>
      <div class="cs-pp__body">
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #3B82F6;"></span>
          <span>Video tutorial library</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #3B82F6;"></span>
          <span>Quizzes and assessments</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #3B82F6;"></span>
          <span>Certification preparation</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #3B82F6;"></span>
          <span>Subscription pricing model</span>
        </div>
      </div>
    </div>

    <div class="cs-pp__divider">VS</div>

    <div class="cs-pp__col cs-pp__pod">
      <div class="cs-pp__header" style="background: color-mix(in srgb, #FF6B35 8%, transparent); border-bottom: 1px solid var(--color-border, #1e1e2e);">
        <span class="cs-pp__tag" style="color: #FF6B35;">Points of Difference</span>
        <h3 class="cs-pp__title">What makes KodeKloud unique</h3>
      </div>
      <div class="cs-pp__body">
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #FF6B35;"></span>
          <span>Real cloud labs in browser, zero setup</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #FF6B35;"></span>
          <span>Hands-on sandboxes for every course</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #FF6B35;"></span>
          <span>Community labs with user scenarios</span>
        </div>
        <div class="cs-pp__item">
          <span class="cs-pp__bullet" style="background: #FF6B35;"></span>
          <span>Instant access, no local setup required</span>
        </div>
      </div>
    </div>
  </div>

  <div class="cs-highlight">
    <p>
      "For career-focused IT professionals who are tired of passive video courses, KodeKloud is the hands-on cloud training platform that delivers real labs in minutes, not hours. So you can actually do, not just watch."
    </p>
  </div>

  <!-- SECTION 3 — KEY RESULTS -->
  <section class="cs-section">
    <span class="cs-section__label">Results</span>
    <h2 class="cs-section__heading">The numbers that came out of it</h2>
  </section>

  <div class="cs-stats">
    <StatCard number="300K+" label="YouTube Subscribers (from 125K)" />
    <StatCard number="18%" label="CTR Improvement" />
    <StatCard number="3×" label="Content Output Increase" />
    <StatCard number="4–6" label="Videos Shipped per Month" />
  </div>

  <!-- SECTION — PRODUCTION PIPELINE -->
  <section class="cs-section">
    <span class="cs-section__label">The System</span>
    <h2 class="cs-section__heading">Production pipeline: from raw footage to published video</h2>
    <p>
      I designed the entire animation production pipeline from scratch. A structured 3-stage workflow that turned chaotic video production into a repeatable, predictable system. Every video, regardless of complexity, went through the same process.
    </p>
  </section>

  <!-- Pipeline visualization -->
  <div class="cs-pipeline">
    <div class="cs-pipeline__stage">
      <div class="cs-pipeline__stage-header" style="--stage-color: #3B82F6;">
        <span class="cs-pipeline__stage-num">Stage 1</span>
        <h3>Ideation &amp; Planning</h3>
        <span class="cs-pipeline__stage-duration">~1 day</span>
      </div>
      <div class="cs-pipeline__steps">
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">Watch &amp; Linear Edit</span>
          <span class="cs-pipeline__step-time">2 hr</span>
        </div>
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">Storyboard &amp; Documentation</span>
          <span class="cs-pipeline__step-time">0.5 day</span>
        </div>
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">Asset Gathering / Creation</span>
          <span class="cs-pipeline__step-time">0.5 day</span>
        </div>
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">Deadline Estimation</span>
          <span class="cs-pipeline__step-time">Based on complexity</span>
        </div>
      </div>
    </div>

    <div class="cs-pipeline__arrow">→</div>

    <div class="cs-pipeline__stage">
      <div class="cs-pipeline__stage-header" style="--stage-color: #F59E0B;">
        <span class="cs-pipeline__stage-num">Stage 2</span>
        <h3>Animation</h3>
        <span class="cs-pipeline__stage-duration">~4 days</span>
      </div>
      <div class="cs-pipeline__complexity">
        <div class="cs-pipeline__complexity-item">
          <span class="cs-pipeline__complexity-label" style="color: #10B981;">Simple</span>
          <span class="cs-pipeline__complexity-rate">180–300 s/day</span>
        </div>
        <div class="cs-pipeline__complexity-item">
          <span class="cs-pipeline__complexity-label" style="color: #F59E0B;">Intermediate</span>
          <span class="cs-pipeline__complexity-rate">90–180 s/day</span>
        </div>
        <div class="cs-pipeline__complexity-item">
          <span class="cs-pipeline__complexity-label" style="color: #EF4444;">Complex</span>
          <span class="cs-pipeline__complexity-rate">15–60 s/day</span>
        </div>
      </div>
    </div>

    <div class="cs-pipeline__arrow">→</div>

    <div class="cs-pipeline__stage">
      <div class="cs-pipeline__stage-header" style="--stage-color: #8B5CF6;">
        <span class="cs-pipeline__stage-num">Stage 3</span>
        <h3>Review, Refine &amp; Wrap</h3>
        <span class="cs-pipeline__stage-duration">~2.5 days</span>
      </div>
      <div class="cs-pipeline__steps">
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">v1 Review (content focus)</span>
          <span class="cs-pipeline__step-time">~1 day</span>
        </div>
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">v2 Review (aesthetics)</span>
          <span class="cs-pipeline__step-time">0.5 day</span>
        </div>
        <div class="cs-pipeline__step">
          <span class="cs-pipeline__step-title">Sound Design &amp; Render Final</span>
          <span class="cs-pipeline__step-time">1 day</span>
        </div>
      </div>
    </div>
  </div>

  <div class="cs-highlight">
    <p>
      This pipeline transformed improvised production into a predictable, scalable system that let a team of one to two people ship at the rate of a much larger operation.
    </p>
  </div>

  <!-- SECTION 4 — ALL VIDEOS -->
  <section class="cs-section">
    <span class="cs-section__label">The Work</span>
    <h2 class="cs-section__heading">Every video, every format across the KodeKloud channel</h2>
    <p>
      All 25 videos produced during this period, organized by category. Each crafted in After Effects and Premiere Pro, with assets from Envato Elements.
    </p>
  </section>

  <!-- Category: Reels -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">Reels: Short-Form Social Content</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Vertical, fast-paced content built for YouTube Shorts and Instagram.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="wnVlUPHSz94" caption="Softskills for DevOps. Vertical reel with captions and emoji integration." />
    <VideoEmbed videoId="fT1cmv1wKvk" caption="DevOps Portfolio. Split-screen tips versus bad examples." />
    <VideoEmbed videoId="lqoO93a803s" caption="What Are Microservices. Mansion versus houses metaphor." />
  </div>

  <!-- Category: Campaigns -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">Campaigns: Event and Product Launches</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Campaign videos for Free Week, Black Friday, product launches, and community events.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="em2rQkTsvks" caption="Free Week 2023. Celebratory style with 3D assets and countdown." />
    <VideoEmbed videoId="uuqP1KgBrxA" caption="Free Week April 2024. Cosmic hybrid with portal transitions." />
    <VideoEmbed videoId="mWS43fD-u74" caption="Free Week New. GenAI narrative with AI environments." />
    <VideoEmbed videoId="IKCcbJAA8cU" caption="Black Friday AI. Cyberpunk with neural overlays." />
    <VideoEmbed videoId="LlEUyGueFtc" caption="Cloud Landing Page. UI-first with cursor-follow motion." />
    <VideoEmbed videoId="H_DIAOonzsA" caption="Kubernetes Sales Ad. Bold typography with K8s logo." />
    <VideoEmbed videoId="gxBZEn7k1Hs" caption="100 Days of DevOps. Campaign with task cards and progress." />
    <VideoEmbed videoId="0xj2VJax0ok" caption="Roadmap Podcast Trailer. Speaker intros with waveform animations." />
    <VideoEmbed videoId="qkBKLp1cLOo" caption="Discord Study Group Promo. Community engagement campaign." />
  </div>

  <!-- Category: Explainer -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">Explainers: Educational Deep Dives</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Long-form technical content from 8 to 17 minutes. Architectural diagrams, code highlighting, and mascot animations.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="hB5bHHBaQuw" caption="Google A2A Protocol. AI architecture with diagram expansion." />
    <VideoEmbed videoId="ejdQYOjNGLw" caption="How Not to Be a Jerk. 2D workplace animation." />
    <VideoEmbed videoId="3pDi6K3KrEc" caption="Kubernetes SIG. Technical visualization with kinetic typography." />
    <VideoEmbed videoId="s_tb_t0L27g" caption="Kubernetes 1.31 Update. Presentation with code highlighting." />
    <VideoEmbed videoId="9fpHqmbCF3Q" caption="DevOps Tools. Kinetic typography with tool breakdown." />
    <VideoEmbed videoId="scZnVDAXbjI" caption="Technical Debt. Visual metaphors with quadrant charts." />
  </div>

  <!-- Category: Tutorials and Intros -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">Tutorials and Intros</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Brand introductions and flagship content that set the visual tone for the channel.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="F31ia2l32RQ" caption="What Is Kubestronaut. Cinematic film with HUD overlays." />
    <VideoEmbed videoId="86tgoICjQxw" caption="CSI Secrets Intro. Hacker aesthetic with neon effects." />
  </div>

  <!-- Category: Demand Gen -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">Demand Generation</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Performance videos designed to drive enrollments and conversions.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="ATWz0saQkV0" caption="K8s Demand Gen 2024. 3D clusters with light-trails." />
    <VideoEmbed videoId="1IGxGSB__Dc" caption="K8s Demand Gen 2023. Code snippets with architecture diagrams." />
  </div>

  <!-- Category: B2B and Promo -->
  <div class="cs-section">
    <span class="cs-section__label" style="font-size:0.85rem;color:#FF6B35;">Category</span>
    <h3 class="cs-section__heading" style="font-size:clamp(1.3rem,2.5vw,1.7rem);">B2B and Brand Promos</h3>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.5rem;">
      Corporate-facing content balancing technical credibility with brand appeal.
    </p>
  </div>

  <div class="cs-video-grid">
    <VideoEmbed videoId="UkFOnQ4okYU" caption="B2B General. Data-driven enterprise style with infographics and UI mockups." />
    <VideoEmbed videoId="z7orjrI88qY" caption="B2B Bosch July. Premium brand film with split-screen visuals." />
    <VideoEmbed videoId="jWPec6tEim8" caption="60 Second Brand Hero. Montage with course cards and typing." />
    <VideoEmbed videoId="F9xuKXfjiHc" caption="Fresh Grad Ad. Sketch-style animation with salary milestone reveals." />
  </div>

  <!-- SECTION 5 — MY ROLE -->
  <section class="cs-section">
    <span class="cs-section__label">My Role</span>
    <h2 class="cs-section__heading">What building from zero actually looked like</h2>
    <p>
      There was no team to optimize. I hired and managed the creative team, built brand guidelines from scratch, set up the production pipeline (brief, script, storyboard, production, QC, publish), managed stakeholders across CEO, CMO, and subject matter experts, and integrated GenAI workflows that tripled output.
    </p>
    <p>
      Descript handled rough-cut editing. Claude handled script drafts. The templating system meant repeat formats shipped in half the time. This is what allowed a small team to produce at the rate of a much larger operation.
    </p>
  </section>

  <!-- SECTION 6 — IMPACT -->
  <section class="cs-section">
    <span class="cs-section__label">Impact</span>
    <h2 class="cs-section__heading">Became the creative infrastructure for the entire company</h2>
    <p>
      By the time I left, the operation was self-sustaining. Monthly organic views went from 184K to 333K, with daily views nearly doubling from 5,950 to 10,700. The channel more than doubled in subscribers. The content strategy shifted from CEO-driven improvisation to a structured, audience-informed calendar. The team had a playbook for every format.
    </p>
    <p>
      This case study shows that I can build a creative operation from nothing, not just manage an existing one.
    </p>
  </section>

</CaseStudyLayout>

<style is:global>
  /* ── Pipeline Visualization ────────────────── */
  .cs-pipeline {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin: 0 0 4rem 0;
    flex-wrap: wrap;
  }

  .cs-pipeline__stage {
    flex: 1;
    min-width: 220px;
    background: var(--color-surface, #111118);
    border: 1px solid var(--color-border, #1e1e2e);
    border-radius: 10px;
    overflow: hidden;
  }

  .cs-pipeline__stage-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border, #1e1e2e);
    background: color-mix(in srgb, var(--stage-color, #3B82F6) 8%, transparent);
  }

  .cs-pipeline__stage-num {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--stage-color, #3B82F6);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .cs-pipeline__stage-header h3 {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text, #f0f0f0);
    margin: 0;
  }

  .cs-pipeline__stage-duration {
    font-size: 0.75rem;
    color: var(--color-text-muted, #666680);
    margin-top: 0.2rem;
    display: block;
  }

  .cs-pipeline__steps {
    padding: 0.75rem 1.25rem;
  }

  .cs-pipeline__step {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    gap: 0.5rem;
  }

  .cs-pipeline__step:last-child {
    border-bottom: none;
  }

  .cs-pipeline__step-title {
    font-size: 0.8rem;
    color: var(--color-text-muted, #666680);
  }

  .cs-pipeline__step-time {
    font-size: 0.75rem;
    color: var(--color-text, #f0f0f0);
    font-weight: 500;
    white-space: nowrap;
  }

  .cs-pipeline__arrow {
    display: flex;
    align-items: center;
    font-size: 1.5rem;
    color: var(--color-text-muted, #666680);
    flex-shrink: 0;
    padding: 0 0.25rem;
  }

  .cs-pipeline__complexity {
    padding: 0.75rem 1.25rem;
  }

  .cs-pipeline__complexity-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .cs-pipeline__complexity-item:last-child {
    border-bottom: none;
  }

  .cs-pipeline__complexity-label {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .cs-pipeline__complexity-rate {
    font-size: 0.75rem;
    color: var(--color-text-muted, #666680);
    font-family: 'Inter', monospace;
  }

  @media (max-width: 640px) {
    .cs-pipeline {
      flex-direction: column;
    }
    .cs-pipeline__arrow {
      transform: rotate(90deg);
      justify-content: center;
      padding: 0.5rem 0;
    }
  }

  /* ── Brand Decode Grid ── */
  .cs-brand-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .cs-brand-card {
    background: var(--color-surface, #111118);
    border: 1px solid var(--color-border, #1e1e2e);
    border-radius: 10px;
    padding: 1.25rem;
    border-left: 3px solid var(--card-accent, #FF6B35);
    transition: border-color 0.25s ease;
  }

  .cs-brand-card:hover {
    border-color: var(--card-accent, #FF6B35);
  }

  .cs-brand-tag {
    display: inline-block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--card-accent, #FF6B35);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .cs-brand-title {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text, #f0f0f0);
    margin: 0 0 0.4rem 0;
    line-height: 1.2;
  }

  .cs-brand-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted, #666680);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .cs-brand-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Video Grid ── */
  .cs-video-grid {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 4rem;
  }

  /* ── POP / POD Comparison ── */
  .cs-pp {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 4rem;
