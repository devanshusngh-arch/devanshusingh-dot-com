---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<Layout title="Blog">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="font-display italic text-4xl md:text-5xl text-white mb-12">Blog</h1>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group block border border-white/[0.06] bg-white/[0.02] transition-all duration-300 hover:border-white/[0.12] hover:bg-white/[0.04]">
          <img src={post.data.image} alt={post.data.title} class="aspect-[16/10] w-full object-cover" loading="lazy" />
          <div class="p-4">
            <span class="text-[10px] uppercase tracking-wider text-neutral-500">#{post.data.category}</span>
            <h3 class="mt-2 font-medium text-lg text-white">{post.data.title}</h3>
            <p class="mt-2 text-sm text-neutral-500 line-clamp-2">{post.data.description}</p>
            <p class="mt-4 text-xs text-neutral-600">{post.data.publishDate}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
