---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" active="contact">

	<section class="section">

		<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start;">

			<!-- Left: Info -->
			<div>
				<h1 class="display-heading" style="font-size: clamp(40px, 7vw, 72px); margin: 0 0 56px 0;">
					Get in touch
				</h1>

				<div style="display: flex; flex-direction: column; gap: 32px;">
					<div>
						<span class="section-label" style="margin-bottom: 8px;">Email</span>
						<a href="mailto:devanshusngh@gmail.com" style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 16px; color: var(--primary); text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--primary)'">
							devanshusngh@gmail.com
						</a>
					</div>

					<div>
						<span class="section-label" style="margin-bottom: 8px;">Phone</span>
						<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 16px; color: var(--primary); margin: 0;">
							+91 87505 88980
						</p>
					</div>

					<div>
						<span class="section-label" style="margin-bottom: 8px;">LinkedIn</span>
						<a href="https://linkedin.com/in/devanshu-singh-356896a0" target="_blank" rel="noopener noreferrer" style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 15px; color: var(--primary); text-decoration: none; transition: color 0.2s ease; word-break: break-all;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--primary)'">
							linkedin.com/in/devanshu-singh-356896a0
						</a>
					</div>

					<div>
						<span class="section-label" style="margin-bottom: 8px;">Location</span>
						<p style="font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: 16px; color: var(--primary); margin: 0;">
							Bengaluru, India <span style="color: var(--muted); font-weight: 300;">· Open to remote</span>
						</p>
					</div>
				</div>
			</div>

			<!-- Right: Form -->
			<div>
				<form action="mailto:devanshusngh@gmail.com" method="post" enctype="text/plain" style="display: flex; flex-direction: column; gap: 28px;">

					<div class="form-group">
						<label for="name" class="form-label">Name</label>
						<input type="text" id="name" name="name" required class="form-input" placeholder="Jane Doe" />
					</div>

					<div class="form-group">
						<label for="email" class="form-label">Email</label>
						<input type="email" id="email" name="email" required class="form-input" placeholder="jane@example.com" />
					</div>

					<div class="form-group">
						<label for="message" class="form-label">Message</label>
						<textarea id="message" name="message" rows="6" required class="form-textarea" placeholder="How can I help you?"></textarea>
					</div>

					<div>
						<button type="submit" class="form-submit">Send Message</button>
					</div>

				</form>
			</div>

		</div>

	</section>

</Layout>

<style>
	@media (max-width: 640px) {
		section > div {
			grid-template-columns: 1fr !important;
			gap: 48px !important;
		}
	}
</style>
