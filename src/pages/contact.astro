---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" active="contact" description="Get in touch with Devanshu Singh. Email, LinkedIn, and contact form for creative leadership, brand strategy, and production inquiries.">

  <!-- Hero -->
  <section class="relative mx-auto w-full max-w-5xl pt-28 pb-8 px-4">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full overflow-hidden">
      <div class="absolute inset-y-0 left-4 w-px bg-gradient-to-b from-transparent via-white/[0.06] to-transparent md:left-8"></div>
      <div class="absolute inset-y-0 right-4 w-px bg-gradient-to-b from-transparent via-white/[0.06] to-transparent md:right-8"></div>
    </div>
    <div class="relative">
      <span class="text-sm tracking-widest text-neutral-500 uppercase mb-4 block">Contact</span>
      <h1 class="text-5xl md:text-6xl font-display italic text-white mb-3">Get in touch</h1>
      <p class="text-base text-neutral-400 max-w-lg">Looking for a creative lead, brand strategist, or GenAI-native producer? Let's talk.</p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-8 pb-24 px-6 max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">

      <!-- Left: Contact Info -->
      <div class="md:col-span-2 flex flex-col gap-4">

        <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-xl p-5 transition-all duration-300 hover:border-white/20">
          <span class="text-xs uppercase tracking-widest text-neutral-500 font-medium block mb-2">Email</span>
          <a href="mailto:devanshusngh@gmail.com" class="text-sm text-white hover:text-indigo-300 transition-colors underline underline-offset-2 decoration-white/10 hover:decoration-indigo-300/30">
            devanshusngh@gmail.com
          </a>
        </div>

        <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-xl p-5 transition-all duration-300 hover:border-white/20">
          <span class="text-xs uppercase tracking-widest text-neutral-500 font-medium block mb-2">Phone</span>
          <p class="text-sm text-white">+91 87505 88980</p>
        </div>

        <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-xl p-5 transition-all duration-300 hover:border-white/20">
          <span class="text-xs uppercase tracking-widest text-neutral-500 font-medium block mb-2">LinkedIn</span>
          <a href="https://linkedin.com/in/devanshu-singh-356896a0" target="_blank" rel="noopener noreferrer" class="text-sm text-white hover:text-indigo-300 transition-colors underline underline-offset-2 decoration-white/10 hover:decoration-indigo-300/30 break-all">
            linkedin.com/in/devanshu-singh-356896a0
          </a>
        </div>

        <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-xl p-5 transition-all duration-300 hover:border-white/20">
          <span class="text-xs uppercase tracking-widest text-neutral-500 font-medium block mb-2">Location</span>
          <p class="text-sm text-white">
            Bengaluru, India <span class="text-neutral-500">· Open to remote</span>
          </p>
        </div>

      </div>

      <!-- Right: Form -->
      <div class="md:col-span-3">
        <form action="mailto:devanshusngh@gmail.com" method="post" enctype="text/plain" class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-xl p-6 md:p-8 flex flex-col gap-6">
          
          <div class="flex flex-col gap-2">
            <label for="name" class="text-xs uppercase tracking-widest text-neutral-500 font-medium">Name</label>
            <input type="text" id="name" name="name" required placeholder="Jane Doe"
              class="w-full rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-neutral-600 outline-none transition-all duration-200 focus:border-white/20 focus:bg-white/[0.05] focus:ring-1 focus:ring-white/10" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs uppercase tracking-widest text-neutral-500 font-medium">Email</label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com"
              class="w-full rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-neutral-600 outline-none transition-all duration-200 focus:border-white/20 focus:bg-white/[0.05] focus:ring-1 focus:ring-white/10" />
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs uppercase tracking-widest text-neutral-500 font-medium">Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="How can I help you?"
              class="w-full rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-white placeholder-neutral-600 outline-none transition-all duration-200 focus:border-white/20 focus:bg-white/[0.05] focus:ring-1 focus:ring-white/10 resize-y min-h-[120px]"></textarea>
          </div>

          <div>
            <button type="submit"
              class="inline-flex items-center gap-2 border border-neutral-600 text-white px-8 py-3 rounded-full hover:bg-white hover:text-black transition-all duration-300 text-sm tracking-wide">
              Send Message
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
            </button>
          </div>

        </form>
      </div>

    </div>
  </section>

</Layout>

<style>
  .font-display {
    font-family: 'Playfair Display', serif;
    font-style: italic;
  }
</style>
