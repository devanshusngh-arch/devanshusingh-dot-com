---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
	<section class="section-container min-h-[70vh] flex flex-col justify-center">
		<div class="grid md:grid-cols-2 gap-20">
			<div class="space-y-12">
				<h1 class="font-display italic text-[48px] md:text-[80px] leading-[1.1] tracking-luxury-heading text-[#f0f0f0]">
					Get in touch
				</h1>
				
				<div class="space-y-6">
					<div>
						<p class="all-caps-label mb-2">Email</p>
						<a href="mailto:devanshusngh@gmail.com" class="text-[18px] text-[#f0f0f0] hover:text-luxury-accent transition-colors">devanshusngh@gmail.com</a>
					</div>
					<div>
						<p class="all-caps-label mb-2">Phone</p>
						<p class="text-[18px] text-[#f0f0f0]">+91 87505 88980</p>
					</div>
					<div>
						<p class="all-caps-label mb-2">LinkedIn</p>
						<a href="https://linkedin.com/in/devanshu-singh-356896a0" target="_blank" class="text-[18px] text-[#f0f0f0] hover:text-luxury-accent transition-colors">linkedin.com/in/devanshu-singh-356896a0</a>
					</div>
					<div>
						<p class="all-caps-label mb-2">Location</p>
						<p class="text-[18px] text-[#f0f0f0]">Bengaluru, India · <span class="text-luxury-muted font-light">Open to remote</span></p>
					</div>
				</div>
			</div>

			<div>
				<form action="mailto:devanshusngh@gmail.com" method="post" enctype="text/plain" class="space-y-8">
					<div class="space-y-3">
						<label for="name" class="text-[13px] font-medium text-luxury-muted uppercase tracking-wider">Name</label>
						<input type="text" id="name" name="name" required class="w-full bg-white/5 border border-white/10 rounded-none px-4 py-3 focus:outline-none focus:border-luxury-accent transition-colors text-white font-light" placeholder="Jane Doe" />
					</div>
					
					<div class="space-y-3">
						<label for="email" class="text-[13px] font-medium text-luxury-muted uppercase tracking-wider">Email</label>
						<input type="email" id="email" name="email" required class="w-full bg-white/5 border border-white/10 rounded-none px-4 py-3 focus:outline-none focus:border-luxury-accent transition-colors text-white font-light" placeholder="jane@example.com" />
					</div>

					<div class="space-y-3">
						<label for="message" class="text-[13px] font-medium text-luxury-muted uppercase tracking-wider">Message</label>
						<textarea id="message" name="message" rows="5" required class="w-full bg-white/5 border border-white/10 rounded-none px-4 py-3 focus:outline-none focus:border-luxury-accent transition-colors text-white font-light resize-none" placeholder="How can I help you?"></textarea>
					</div>

					<button type="submit" class="px-8 py-4 bg-luxury-accent text-white text-[14px] font-semibold hover:bg-luxury-accent-hover transition-all duration-300">
						Send Message
					</button>
				</form>
			</div>
		</div>
	</section>
</Layout>
