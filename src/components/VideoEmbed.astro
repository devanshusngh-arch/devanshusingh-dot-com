---
/*
  VideoEmbed.astro
  ================
  Thumbnail card with play overlay — opens a full-screen modal video player.
  Uses VideoButton React component for smooth animations.

  Usage:
    <VideoEmbed
      videoId="YOUR_YOUTUBE_VIDEO_ID"
      caption="Free Week Campaign. KodeKloud (2023)"
    />
*/
import VideoButton from './VideoButton';

interface Props {
  videoId: string;
  caption?: string;
}

const { videoId, caption } = Astro.props;
---

<VideoButton videoId={videoId} caption={caption} client:visible />
