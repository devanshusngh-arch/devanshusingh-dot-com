---
/**
 * ToolsOrbit — devanshusingh.com
 * 
 * Re-implemented as a pure Astro component with Vanilla JS 
 * and "Remotion-style" orbital animations for smooth, slow rotation.
 */

const categories = [
  {
    id: 'genai',
    label: 'GenAI & Automation',
    description: 'AI-native tools that cut production time by 35% without compromising quality.',
    tools: [
      { name: 'Claude Code', icon: '⚡' },
      { name: 'Claude API', icon: '🤖' },
      { name: 'n8n', icon: '⚙️' },
      { name: 'Adobe Firefly', icon: '🔥' },
      { name: 'ElevenLabs', icon: '🗣️' },
      { name: 'Descript', icon: '🎙️' },
    ],
  },
  {
    id: 'creative',
    label: 'Creative Production',
    description: 'The core suite for video, motion, and visual design at scale.',
    tools: [
      { name: 'After Effects', icon: '🎬' },
      { name: 'Premiere Pro', icon: '🎞️' },
      { name: 'Photoshop', icon: '📸' },
      { name: 'Illustrator', icon: '✏️' },
      { name: 'InDesign', icon: '📐' },
      { name: 'Canva', icon: '🖼️' },
    ],
  },
  {
    id: 'design',
    label: 'Design & Systems',
    description: 'Where brand systems, UI, and design tokens come to life.',
    tools: [
      { name: 'Figma', icon: '🎨' },
      { name: 'Frame.io', icon: '🖥️' },
      { name: 'Google Fonts', icon: '🔤' },
      { name: 'Coolors', icon: '🎯' },
      { name: 'Notion', icon: '📝' },
      { name: 'Whimsical', icon: '💭' },
    ],
  },
  {
    id: 'analytics',
    label: 'Analytics & Ops',
    description: 'Data-informed creative decisions — not gut feel.',
    tools: [
      { name: 'GA4', icon: '📊' },
      { name: 'YouTube Studio', icon: '📺' },
      { name: 'HubSpot', icon: '🧲' },
      { name: 'ClickUp', icon: '✅' },
      { name: 'Slack', icon: '💬' },
      { name: 'Zapier AI', icon: '🔗' },
    ],
  },
];
---

<section class="py-10 md:py-14 overflow-hidden">
  <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center max-w-5xl mx-auto px-4">
    
    {/* LEFT: Category tabs + description */}
    <div class="flex-1 min-w-0">
      <p class="text-[10px] font-medium uppercase tracking-[0.15em] text-neutral-500 mb-2">What I work with</p>
      <h2 class="font-display italic text-xl md:text-2xl text-white mb-6">Tools & Stack</h2>
      <div class="flex flex-col gap-1" id="category-tabs">
        {categories.map((cat, idx) => (
          <button
            data-category={cat.id}
            class={`category-tab text-left px-4 py-3 rounded-lg border transition-all duration-250 text-sm ${idx === 0 ? 'active' : ''}`}
          >
            {cat.label}
          </button>
        ))}
      </div>
      <p id="category-description" class="mt-5 text-[13px] text-neutral-600 leading-relaxed max-w-xs">
        {categories[0].description}
      </p>
    </div>

    {/* RIGHT: Orbital animation */}
    <div class="flex-shrink-0 w-[380px] h-[380px] relative orbital-container" id="orbital-container">
      <svg class="absolute inset-0 w-full h-full pointer-events-none">
        <circle cx="190" cy="190" r="82" fill="none" stroke="rgba(255,255,255,0.05)" strokeWidth="1" strokeDasharray="3 5">
          <animateTransform attributeName="transform" type="rotate" from="0 190 190" to="360 190 190" dur="80s" repeatCount="indefinite"/>
        </circle>
        <circle cx="190" cy="190" r="165" fill="none" stroke="rgba(255,255,255,0.035)" strokeWidth="1" strokeDasharray="3 5">
          <animateTransform attributeName="transform" type="rotate" from="0 190 190" to="-360 190 190" dur="110s" repeatCount="indefinite"/>
        </circle>
      </svg>

      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
        <div class="w-10 h-10 rounded-full border border-white/[0.08] flex items-center justify-center" style="background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 70%)">
          <div class="w-3 h-3 rounded-full bg-white/20 animate-pulse"></div>
        </div>
      </div>

      <div id="tools-display" class="relative w-full h-full">
        {/* Tools will be rendered and animated here by JS */}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes toolFadeIn {
    from { opacity: 0; transform: translate(-50%,-50%) scale(0.7); }
    to { opacity: 1; transform: translate(-50%,-50%) scale(1); }
  }
  
  .category-tab {
    border: 1px solid transparent;
    background: transparent;
    color: #737373;
    transition: all 0.25s ease;
  }

  .category-tab:hover {
    color: #d4d4d4;
    background-color: rgba(255,255,255,0.02);
  }

  .category-tab.active {
    border-color: rgba(255,255,255,0.12) !important;
    background-color: rgba(255,255,255,0.04) !important;
    color: white !important;
    font-weight: 500 !important;
  }

  @media (max-width: 768px) {
    .orbital-container {
      transform: scale(0.8);
      margin: -40px 0;
    }
  }
</style>

<script define:vars={{ categories }}>
  const tabs = document.querySelectorAll('.category-tab');
  const description = document.getElementById('category-description');
  const toolsDisplay = document.getElementById('tools-display');
  const orbitalContainer = document.getElementById('orbital-container');

  let rotation = 0;
  let running = true;
  let currentCategoryId = 'genai';

  function renderTools(categoryId) {
    currentCategoryId = categoryId;
    const active = categories.find(c => c.id === categoryId);
    if (!active || !toolsDisplay) return;

    toolsDisplay.innerHTML = '';

    // Create tool elements
    active.tools.slice(0, 6).forEach((tool, i) => {
      const el = document.createElement('div');
      el.className = `tool-node tool-${i} absolute flex flex-col items-center gap-1.5 transition-opacity duration-500 ease-out`;
      el.style.opacity = '0';
      el.style.animation = `toolFadeIn 0.4s ease-out ${i * 80}ms forwards`;
      el.style.willChange = 'transform, left, top';
      
      const size = i < 3 ? 'w-11 h-11' : 'w-10 h-10';
      const ringClass = i < 3 ? 'bg-white/[0.04] border-white/[0.1] text-lg' : 'bg-white/[0.03] border-white/[0.08] text-base';
      const textClass = i < 3 ? 'text-neutral-500' : 'text-neutral-400';

      el.innerHTML = `
        <div class="${size} rounded-full border ${ringClass} flex items-center justify-center hover:bg-white/[0.08] hover:border-white/[0.2] hover:scale-110 transition-all duration-300 cursor-default">${tool.icon}</div>
        <span class="text-[10px] ${textClass} whitespace-nowrap font-inter">${tool.name}</span>
      `;
      toolsDisplay.appendChild(el);
    });
  }

  function tick() {
    if (running) {
      rotation += 0.0012; // Slowed down for high-end feel (0.003 -> 0.0012)
      
      const toolNodes = toolsDisplay.querySelectorAll('.tool-node');
      toolNodes.forEach((node, i) => {
        const isInner = i < 3;
        const radius = isInner ? 82 : 165;
        
        // Base angles to space them out
        const baseAngle = isInner ? ((360 / 3) * i - 90) : ((360 / 3) * (i - 3) - 30);
        
        // Apply "Remotion-style" orbital math
        const angleRad = (baseAngle * Math.PI / 180) + (isInner ? rotation : -rotation * 0.6);
        const x = 190 + radius * Math.cos(angleRad);
        const y = 190 + radius * Math.sin(angleRad);
        
        node.style.left = `${x}px`;
        node.style.top = `${y}px`;
        node.style.transform = 'translate(-50%,-50%)';
      });
    }
    requestAnimationFrame(tick);
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-category');
      
      // Update UI
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const cat = categories.find(c => c.id === id);
      if (description && cat) description.textContent = cat.description;
      
      renderTools(id);
    });
  });

  // Handle hover to pause
  if (orbitalContainer) {
    orbitalContainer.addEventListener('mouseenter', () => { running = false; });
    orbitalContainer.addEventListener('mouseleave', () => { running = true; });
  }

  // Initial render & start loop
  renderTools('genai');
  tick();
</script>
