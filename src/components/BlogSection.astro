---
/**
 * BlogSection — Latest articles grid for homepage
 * Adapted for Astro from a Next.js/shadcn design
 */
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);
---

<section class="px-4 py-16 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 text-center">
      <p class="mb-3 font-medium text-neutral-500 text-xs uppercase tracking-[0.15em]">
        Insights
      </p>
      <h2 class="font-display italic text-3xl md:text-4xl text-white tracking-tight">
        Latest Articles
      </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group block border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm transition-all duration-300 hover:border-white/[0.12] hover:bg-white/[0.04]">
          <div class="relative">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="aspect-[16/10] w-full object-cover"
              loading="lazy"
            />
            <span class="absolute top-0 left-0 bg-[#0a0a0f]/90 px-2.5 py-1 text-[10px] font-medium uppercase tracking-wider text-neutral-300 backdrop-blur-sm">
              #{post.data.category}
            </span>
          </div>
          <div class="px-4 pb-4 pt-4">
            <h3 class="mb-2 font-medium text-base md:text-lg text-white tracking-tight leading-snug group-hover:text-neutral-200 transition-colors">
              {post.data.title}
            </h3>
            <p class="mb-5 text-xs md:text-sm text-neutral-500 leading-relaxed line-clamp-2">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2 text-xs font-medium text-white group-hover:text-neutral-300 transition-colors">
                <span class="flex items-center justify-center w-8 h-8 border border-white/10 transition-colors duration-300 group-hover:bg-white group-hover:text-black">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
                Read more
              </span>
              <span class="flex items-center gap-2 text-[10px] text-neutral-600">
                {post.data.publishDate}
                <span class="w-8 border-t border-white/10"></span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
