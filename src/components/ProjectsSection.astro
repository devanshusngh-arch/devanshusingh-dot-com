---
const projects = [
  {
    id: 'marcus',
    title: 'Marcus — AI Brand Strategist',
    subtitle: 'Featured',
    description: 'Brand strategy AI that bridges data and creative intuition using Keller, Aaker, and Kapferer frameworks.',
    tags: ['React', 'Claude API', 'Brand Strategy'],
    link: '/brand-board',
  },
  {
    id: 'resume',
    title: 'AI Resume Generator',
    subtitle: 'Tool',
    description: 'Dynamic HTML resume builder with company-specific tailoring, brand color presets, and PDF export.',
    tags: ['React', 'Claude API', 'HTML/CSS'],
    link: 'javascript:void(0)',
    comingSoon: true,
  },
  {
    id: 'storybolt',
    title: 'StoryBolt — AI Creative Tool',
    subtitle: 'Tool',
    description: 'AI-powered storytelling and content ideation for creative teams and brand managers.',
    tags: ['React', 'GenAI', 'Content Ops'],
    link: 'javascript:void(0)',
    comingSoon: true,
  },
  {
    id: 'brand-engine',
    title: 'Brand Breakdown Engine',
    subtitle: 'Tool',
    description: 'Automated brand audit tool that analyzes visual identity, messaging, and market positioning.',
    tags: ['React', 'Claude API', 'Brand Audit'],
    link: 'javascript:void(0)',
    comingSoon: true,
  },
];
---

<section class="py-20 px-6 max-w-7xl mx-auto">
  <div class="mb-12">
    <p class="all-caps-label mb-2">Built with AI</p>
    <h2 class="font-display italic text-2xl md:text-3xl text-white tracking-tight">
      Projects & Experiments
    </h2>
  </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.link}
          class="group relative flex flex-row items-center gap-3 p-3 pr-10 rounded-xl border border-white/[0.06] bg-zinc-900/60 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 hover:border-white/[0.12]"
        >
          <!-- Arrow -->
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-neutral-600 transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-neutral-300" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="M12 5l7 7-7 7" />
          </svg>

          <!-- Content -->
          <div class="flex flex-1 flex-col gap-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] uppercase tracking-[0.15em] text-neutral-500 font-medium">
                {project.subtitle}
              </span>
              {project.comingSoon && (
                <span class="rounded-full bg-white/[0.04] px-1.5 py-0.5 text-[7px] font-medium uppercase tracking-wider text-neutral-500 border border-white/[0.06]">
                  Upcoming
                </span>
              )}
            </div>

            <h3 class="text-[12px] font-semibold text-white leading-snug tracking-tight group-hover:text-neutral-100 transition-colors">
              {project.title}
            </h3>

            <p class="text-[10px] leading-relaxed text-neutral-500 line-clamp-2">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1">
              {project.tags.map((tag, idx) => (
                <span key={idx} class="rounded-md bg-white/[0.03] px-1.5 py-0.5 text-[8px] text-neutral-500 border border-white/5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
</section>